          "id": "e8abe061-d24f-4684-94bc-5b4d29c29c4a",
          "name": "Get usage summary",
          "request": {
            "name": "Get usage summary",
            "description": {
              "content": "Organization-wide product-usage summary by channel: `web` (web app), `word` (Word add-in), and `api`.\n\nRequires an org-scoped API key — usage is reported org-wide, so a user-scoped key receives a 403. For credit/billing totals, use `GET /v1/credit-usage`.\n\nNote: web/word counts are sourced from product analytics; day boundaries for those channels are approximate (UTC).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "(Required) Inclusive range start (`YYYY-MM-DD`)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "(Required) Inclusive range end (`YYYY-MM-DD`)."
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "UTC",
                  "description": "IANA timezone for the api channel day boundaries (default `UTC`)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
